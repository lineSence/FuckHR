# Скопируй в .env и заполни. .env в git не попадает.

# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Свой chat_id: напиши боту любое сообщение и открой
# https://api.telegram.org/bot<токен>/getUpdates
TELEGRAM_CHAT_ID=

# hh.ru требует осмысленный User-Agent с контактом. OAuth для чтения не нужен.
HH_USER_AGENT=FuckHR/0.1 (you@example.com)

# Пути относительно корня проекта (C:\dev\fuckhr).
DB_PATH=data/fuckhr.sqlite3
LOG_PATH=data/fuckhr.log
