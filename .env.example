# --- Telegram (обязательно для отправки карточек) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Отправка карточек: 0 — прогон работает, карточки ждут в интерфейсе
TELEGRAM_ENABLED=1
# Пауза между сообщениями, сек (меньше 0.5 — Telegram отвечает 429)
TELEGRAM_DELAY=0.6
# Тихие часы, ЧЧ:ММ. Пусто — не молчим. Тревоги канарейки уходят всегда
TELEGRAM_QUIET_FROM=
TELEGRAM_QUIET_TO=

# --- hh.ru: сбор из HTML (ADR-015) ---
# Пауза между запросами в секундах. Меньше 2 — быстрый путь к капче.
HH_PAUSE=2.0
# Нижняя граница адаптивной паузы: на чистых ответах сбор ускоряется до неё
HH_PAUSE_MIN=0.8
# Cookie из браузера, если hh.ru начал требовать капчу (DevTools -> Network -> заголовок Cookie).
HH_COOKIE=
# Прокси вида http://user:pass@host:port. Для RU-сегмента нужен RU-IP.
HH_PROXY=

# --- hh.ru Open API (не используется пайплайном) ---
# Публичный GET /vacancies с апреля 2026 отдаёт 403 без токена приложения.
# Заполни оба поля, если получишь доступ на https://dev.hh.ru/admin — тогда можно вернуться на API.
HH_USER_AGENT=FuckHR/0.1 (me@example.com)
HH_TOKEN=

# --- Пути ---
DB_PATH=data/fuckhr.sqlite3
LOG_PATH=data/fuckhr.log
# Куда кладётся сырой HTML при сбое разбора (хранятся последние 5 файлов).
FAILURE_DIR=data/failures

# --- Канарейка ---
# Где запоминается, о чём уже писали, чтобы не дублировать тревогу каждый прогон.
ALERT_STATE_PATH=data/alerts.json
ALERT_COOLDOWN_HOURS=24

# --- Локальный шлюз к моделям (llm.py, ADR-005) ---
# Пустой LLM_BASE_URL = локального маршрута нет.
# На нём считаются этапы с персональными данными: contacts, dossier, draft [CORE-012].
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=
# Сколько вызовов модели идёт одновременно на этапах extract/hr_filter (максимум 8)
LLM_WORKERS=4
LLM_TIMEOUT=60
# Потолок вызовов за прогон: при исчерпании этапы молча пропускаются [LLM-004].
LLM_MAX_CALLS=300

# --- Внешний прокси к моделям (LiteLLM, ADR-017) ---
# OpenAI-совместимый адрес с /chat/completions, без слеша на конце.
# Если прокси на VPS и прокидывается SSH-туннелем, адрес всё равно локальный:
#   ssh -N -L 4000:127.0.0.1:4000 root@IP_VPS
LLM_PROXY_BASE_URL=
LLM_PROXY_API_KEY=
# Имена моделей на прокси для каждого профиля.
# Пустое значение = отправляется само имя профиля (auto:fast и т.д.),
# так удобно, если алиасы уже объявлены в config.yaml самого LiteLLM.
LLM_PROXY_MODEL_FAST=
LLM_PROXY_MODEL_SMART=
LLM_PROXY_MODEL_LONG=
LLM_PROXY_MODEL_LOCAL=
LLM_PROXY_MODEL_EMBEDDINGS=
# Модель на отдельный этап. Сильнее модели профиля, пустое = берётся профиль.
# Заполняется кнопкой «Подставить в настройки» после сравнения моделей.
LLM_STAGE_MODEL_INTAKE=
LLM_STAGE_MODEL_EXTRACT=
LLM_STAGE_MODEL_HR_FILTER=
LLM_STAGE_MODEL_COMPANY=
LLM_STAGE_MODEL_SCORE=
LLM_STAGE_MODEL_CONTACTS=
LLM_STAGE_MODEL_DOSSIER=
LLM_STAGE_MODEL_DRAFT=
LLM_STAGE_MODEL_RESUME_SECTION=
LLM_STAGE_MODEL_RESUME_TAILOR=
LLM_STAGE_MODEL_EMBEDDINGS=
# ОСТОРОЖНО. 1 = этапы contacts/dossier/draft тоже уходят на прокси.
# В их промптах есть ФИО, должности и контакты живых людей.
# Свой VPS приватности не даёт: важно, куда ходит сам прокси.
LLM_PERSONAL_VIA_PROXY=

# --- Внешний поиск для contact discovery (websearch.py, ADR-011) ---
# searxng (свой инстанс, ключ не нужен), tavily или brave.
# Tavily и Brave требуют привязки карты даже на бесплатном плане.
SEARCH_PROVIDER=searxng
# Адрес своего SearXNG, без слеша на конце. Пустой = поиск выключен.
# В settings.yml инстанса нужен search.formats с json, иначе отдаёт только HTML.
SEARCH_BASE_URL=
# Если инстанс закрыт базовой авторизацией на реверс-прокси: user:pass.
SEARCH_BASIC_AUTH=
# Ключ только для tavily/brave; для searxng оставь пустым.
SEARCH_API_KEY=
SEARCH_TIMEOUT=20
# Потолок запросов за прогон; повторы берутся из кэша в SQLite.
SEARCH_MAX_CALLS=60
# Сколько запросов к поиску идёт одновременно (максимум 8)
SEARCH_WORKERS=4

# --- Тонкая настройка SearXNG (необязательно) ---
# Движки через запятую, например: google,bing,duckduckgo. Пусто = как настроен инстанс.
SEARCH_ENGINES=
# Язык выдачи и категории поиска.
SEARCH_LANGUAGE=ru
SEARCH_CATEGORIES=general
# Окно по времени: day, week, month, year. Пусто = без ограничения.
SEARCH_TIME_RANGE=
# 0 — без фильтра, 1 — умеренный, 2 — строгий.
SEARCH_SAFESEARCH=0
# Сколько страниц выдачи забирать по каждому запросу.
SEARCH_PAGES=1

# --- Чтение страниц отзывов (reviewpage.py) ---
# 0 = досье строится только по заголовкам и сниппетам выдачи. Так делать не стоит:
# именно текст отзывов даёт цитаты под флаги.
REVIEW_FETCH_ENABLED=1
# Сколько страниц отзывов читать на одну компанию.
REVIEW_FETCH_PAGES=8
# Сколько страниц отзывов читается одновременно (максимум 8)
REVIEW_FETCH_WORKERS=4
REVIEW_FETCH_TIMEOUT=20
# Потолок символов, которые берутся с одной страницы.
REVIEW_FETCH_CHARS=8000
# Пауза между страницами в секундах: сайты отзывов тоже умеют блокировать.
REVIEW_FETCH_PAUSE=1.0
# Сколько дней страница считается свежей и берётся из кэша page_cache.
REVIEW_FETCH_CACHE_DAYS=30
# Куда дописывать текст прочитанных отзывов — нужно, чтобы сверять правила
# PATTERN_RULES с живым языком, а не с примерами из тестов. Пусто = не писать.
# В файле чужие тексты, поэтому держи его в data/ (эта папка вне git).
REVIEW_DUMP_PATH=

# Необязательный сигнал модели в детекции накрученных отзывов (этап review_fake).
# По умолчанию выключен: пока пороги не откалиброваны на размеченной выборке,
# ответ модели только зашумляет счёт. Вес сигнала минимальный, сам по себе он
# отзыв не помечает. docs/fake-reviews.md
FAKE_REVIEW_LLM=0

# Необязательный сигнал модели в детекторе сгенерированного текста (этап
# ai_text). По умолчанию выключен по той же причине: пороги не откалиброваны.
# В отличие от review_fake этот этап может ходить на прокси — решение
# владельца, отступление от [CORE-012] описано в docs/ai-text.md.
AI_TEXT_LLM=0

# --- Досье ---
# Сколько компаний изучается одновременно (потолок 8).
RESEARCH_WORKERS=4

# --- Предфильтр (score.py, отсев до загрузки описания) ---
# 0 = собирать всё подряд, включая явный мусор: полезно, когда кажется,
# что фильтр режет лишнее.
PREFILTER_ENABLED=1
# Черновой скор, ниже которого вакансия не открывается. На выдаче скор занижен:
# описания ещё нет, поэтому по умолчанию 0 — отсев только по стоп-словам и вилке.
PREFILTER_MIN_SCORE=0
# Порог нечёткого совпадения навыка в процентах (rapidfuzz).
PREFILTER_FUZZY=88

# --- Детектор HR-брехни (detector.py, ADR-009) ---
# 0 = карточки без HR-флагов. Слепки истории пишутся в любом случае.
DETECTOR_ENABLED=1
# Сколько дней истории нужно, чтобы вывод считался выводом, а не догадкой [HRD-004].
DETECTOR_MIN_DAYS=30
# Сколько перепубликаций подряд опровергают «стабильную команду».
DETECTOR_REPUBLISH_ALARM=3
# Во сколько раз верхняя граница вилки больше нижней, чтобы считать вилку фиктивной.
DETECTOR_WIDE_BAND=2.0
# Подсказка утверждений моделью. Вердикт у таких пунктов всегда
# «недостаточно данных»: модель не решает, а только показывает цитату.
DETECTOR_LLM_CLAIMS=1
