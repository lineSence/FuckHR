# --- Telegram (обязательно для отправки карточек) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- hh.ru: сбор из HTML (ADR-015) ---
# Пауза между запросами в секундах. Меньше 2 — быстрый путь к капче.
HH_PAUSE=2.0
# Cookie из браузера, если hh.ru начал требовать капчу (DevTools -> Network -> заголовок Cookie).
HH_COOKIE=
# Прокси вида http://user:pass@host:port. Для RU-сегмента нужен RU-IP.
HH_PROXY=

# --- hh.ru Open API (не используется пайплайном) ---
# Публичный GET /vacancies с апреля 2026 отдаёт 403 без токена приложения.
# Заполни оба поля, если получишь доступ на https://dev.hh.ru/admin — тогда можно вернуться на API.
HH_USER_AGENT=FuckHR/0.1 (me@example.com)
HH_TOKEN=

# --- Пути ---
DB_PATH=data/fuckhr.sqlite3
LOG_PATH=data/fuckhr.log
# Куда кладётся сырой HTML при сбое разбора (хранятся последние 5 файлов).
FAILURE_DIR=data/failures

# --- Канарейка ---
# Где запоминается, о чём уже писали, чтобы не дублировать тревогу каждый прогон.
ALERT_STATE_PATH=data/alerts.json
ALERT_COOLDOWN_HOURS=24

# --- Шлюз к моделям (llm.py, ADR-005) ---
# Пустой LLM_BASE_URL = шлюз выключен, детектор работает без моделей.
# Сейчас пайплайн ни разу не зовёт модель — переменные готовят шаг 4.
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=60
# Потолок вызовов за прогон: при исчерпании этапы молча пропускаются [LLM-004].
LLM_MAX_CALLS=300

# --- Внешний поиск для contact discovery (websearch.py, ADR-011) ---
# tavily или brave.
SEARCH_PROVIDER=tavily
# Пустой ключ = поиск выключен; этап работает только на уже собранном тексте вакансий.
SEARCH_API_KEY=
SEARCH_TIMEOUT=20
# Потолок запросов за прогон; повторы берутся из кэша в SQLite.
SEARCH_MAX_CALLS=60
